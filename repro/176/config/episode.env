# repro pack copy: local absolute paths replaced by <EP_DIR>, <GROK_BIN>, <TMPDIR>; otherwise identical to the file used in the runs (original md5 26ef708a).
# EP02 (10-04) MarkItDown MCP quick test, ab-harness config. Frozen with plans/2026-10-04-grok-tool-ep02-markitdown-quick-plan.md.
EP_DIR=<EP_DIR>
TOOL=''                                   # MCP-only tool: no plugin skills
CONFIG_A=$EP_DIR/config_A.toml
CONFIG_B=$EP_DIR/config_B.toml
EXPECT_A="0 none"
EXPECT_B="0 markitdown"
CAP_S=600
WATCHDOG_S=240
MAX_CONT=1
MIN_CONT_S=120
CONT_PROMPT='Write the output files in out/ now (out/*.csv, and out/summary.json for L2). Do not reread files you already read and do not write test tools; write a minimal working version first, then fix it. The requirements are the same as in your first message.'
MODEL=grok-4.7; EFFORT=xhigh
RED_EXTRA='docintel|documentintelligence|azure\.|youtube|"uri":\s*"https?://'
TMP_MOVE='<TMPDIR>/mat-debug-*.log <TMPDIR>/markitdown* <TMPDIR>/magika*'
WATCH_EXCLUDE=''
AGENT_ENV='GROK_FOLDER_TRUST=0'
INSPECT_CMD='env -u XAI_API_KEY GROK_FOLDER_TRUST=0 <GROK_BIN> inspect --json'
PREP_HOOK='<EP_DIR>/prep_run.sh {RUN} {L} {G}'
ALLOW_PREEXIST='input'
CHECK_CMD='python3 check_markitdown.py --level {L} --run-dir {RUN} --out {OUT}'
SCORE_SPEC=$EP_DIR/score_spec.json
